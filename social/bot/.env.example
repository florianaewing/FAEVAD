# Copy this file to ~/.config/faevad-social-bot/.env and fill in real values.
# NEVER commit the real .env -- it holds live API secrets.

# Telegram: create a bot via @BotFather in Telegram (free, a couple of
# minutes), it gives you TELEGRAM_BOT_TOKEN. TELEGRAM_CHAT_ID is your own
# chat id with that bot -- message the bot once, then check
# https://api.telegram.org/bot<token>/getUpdates to read your chat id back.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Buffer: Buffer account -> Settings -> API -> create a personal API key.
# Channel ids are per connected profile (Instagram, Pinterest); the board id
# is the Pinterest board pins go on (its "serviceId"). All three can be read
# back from Buffer's GraphQL `channels` query once the channels are connected.
BUFFER_API_KEY=
BUFFER_INSTAGRAM_CHANNEL_ID=
BUFFER_PINTEREST_CHANNEL_ID=
BUFFER_PINTEREST_BOARD_ID=

# --- Optional platforms: each is posted to only once all its keys are set.

# X, via Buffer's third free channel: connect X in Buffer, then read its
# channel id back from the same `channels` query.
BUFFER_X_CHANNEL_ID=

# Bluesky: Settings -> Privacy and security -> App passwords -> Add. Use the
# app password here, never the account's real password.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Mastodon: on your server, Preferences -> Development -> New application,
# scopes read:statuses, write:media and write:statuses (read is for comment
# alerts and stats), then copy "Your access token".
# MASTODON_INSTANCE_URL is the server itself, e.g. https://mastodon.art
MASTODON_INSTANCE_URL=
MASTODON_ACCESS_TOKEN=

# Threads: a Meta developer app with the Threads API use case, the FAEVAD
# Threads account added as a tester, then a long-lived (60-day) token. The
# bot refreshes it weekly on its own and keeps the current one in
# ~/.local/state/faevad-social-bot/threads_token.json -- only replace this
# if it lapses.
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# Facebook Page: a Page access token (from a long-lived user token, so it
# doesn't expire) with pages_manage_posts, plus the Page's numeric id.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# GitHub: lets the bot file each bug report as an issue on the repo, as
# well as sending it on Telegram. github.com -> Settings -> Developer
# settings -> Fine-grained tokens -> Generate: repository access "Only
# select repositories" -> FAEVAD, permission Issues: Read and write, nothing
# else. The repo is public, so reports have every secret redacted first.
GITHUB_TOKEN=

# No Reddit/Facebook Marketplace credentials here -- both are dropped from
# the automated flow for now (Reddit closed personal-script API access,
# Marketplace has no individual-seller API at all). Parked as a later
# browser-automation phase -- see the roadmap memory, not this bot.
