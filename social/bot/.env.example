# Copy this file to ~/.config/faevad-social-bot/.env and fill in real values.
# NEVER commit the real .env -- it holds live API secrets.

# Telegram: create a bot via @BotFather in Telegram (free, a couple of
# minutes), it gives you TELEGRAM_BOT_TOKEN. TELEGRAM_CHAT_ID is your own
# chat id with that bot -- message the bot once, then check
# https://api.telegram.org/bot<token>/getUpdates to read your chat id back.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Buffer: Buffer account -> Settings -> API -> create a personal API key.
# Channel ids are per connected profile (Instagram, Pinterest) -- Buffer's
# dashboard or API should list these once the channels are connected.
BUFFER_API_KEY=
BUFFER_INSTAGRAM_CHANNEL_ID=
BUFFER_PINTEREST_CHANNEL_ID=

# Reddit: create an app at https://www.reddit.com/prefs/apps (type
# "script"), which gives REDDIT_CLIENT_ID/REDDIT_CLIENT_SECRET. The refresh
# token needs a one-time OAuth authorization flow (script apps still need
# this for API access beyond your own read-only rate limit) -- ask for help
# with that step when you're ready to wire this up for real.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=
REDDIT_SUBREDDIT=
REDDIT_USER_AGENT=faevad-social-bot/1.0 (by /u/TheFlorian)
